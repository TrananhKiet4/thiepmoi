{
  "name": "graduation-invitations",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @invite/api\" \"npm run dev -w @invite/web\"",
    "build": "npm run build -w @invite/api && npm run build -w @invite/web",
    "start": "npm run start -w @invite/api",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "admin:create": "tsx apps/api/src/cli.ts admin",
    "seed": "tsx apps/api/src/cli.ts seed",
    "maintenance": "tsx apps/api/src/cli.ts maintenance",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "node scripts/prepare-e2e.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "backup": "node scripts/database.mjs backup",
    "restore": "node scripts/database.mjs restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "music-metadata": "^11.10.3",
    "sharp": "0.35.5",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  }
}
