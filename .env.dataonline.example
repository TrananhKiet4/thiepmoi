APP_NAME="Thiệp mời tốt nghiệp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.trananhkiet.id.vn
APP_ORIGIN=https://www.trananhkiet.id.vn
CORS_ORIGINS=https://www.trananhkiet.id.vn
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=trananhk_thiepmoi
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning

# Copy existing values to keep invitations and sessions valid.
SESSION_SECRET=
INVITATION_KEY=
INVITATION_KEY_VERSION=1
INVITATION_OLD_KEYS={}
ADMIN_BOOTSTRAP_EMAIL=tak1632004@gmail.com
CRON_SECRET=

# Existing private media bucket. The database uses MariaDB above.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET_PRIVATE=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
