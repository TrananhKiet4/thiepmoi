{
    "name": "trananhkiet4/thiepmoi",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "aws/aws-sdk-php": "^3.0",
        "laravel/framework": "^13.0",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    },
    "extra": {
        "aws/aws-sdk-php": ["S3"]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
