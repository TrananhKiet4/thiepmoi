NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://invitation:local_dev_only@localhost:54329/invitations?schema=public
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INVITATION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
INVITATION_KEY_VERSION=1
# JSON map of old versions to base64 keys during rotation; never commit real keys.
INVITATION_OLD_KEYS={}
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/media
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=
FFMPEG_PATH=ffmpeg
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
